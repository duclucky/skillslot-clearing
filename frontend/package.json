{
  "name": "skillslot-clearing-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:api": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --resolveJsonModule --allowSyntheticDefaultImports --skipLibCheck api/a2a-message.ts api/agent-card.ts api/agent-metadata.ts api/studionet-rpc.ts api/fee-quote.ts api/transaction-outcome.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "genlayer-js": "2.0.0-rc.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.55.13"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "29.0.0",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
